+// Point a guest virtual range at pages owned by another guest memblock. This
+// is the page-table equivalent of kubridge's MemBlockCommitPagesWithBase.
+// Unlike add_external_mapping(), this must not copy the reserved target pages
+// over the live backing store: DSVita remaps individual pages while running.
+static bool add_guest_alias_mapping(MemState &mem, Address target, Address source, uint32_t size) {
+    if ((target & 0xFFF) || (source & 0xFFF) || (size & 0xFFF))
+        return false;
+
+    if (!mem.use_page_table) {
+#ifdef _WIN32
+        return false;
+#else
+        if (mem.memory_backing_fd < 0)
+            return false;
+        void *result = mmap(mem.memory.get() + target, size, PROT_READ | PROT_WRITE,
+            MAP_SHARED | MAP_FIXED, mem.memory_backing_fd, source);
+        return result != MAP_FAILED;
+#endif
+    }
+
+    for (uint32_t offset = 0; offset < size; offset += KiB(4)) {
+        const Address source_page = source + offset;
+        const Address target_page = target + offset;
+        uint8_t *source_ptr = mem.page_table[source_page / KiB(4)] + source_page;
+        mem.page_table[target_page / KiB(4)] = source_ptr - target_page;
+    }
+    return true;
+}
+
+static bool is_guest_alias(const MemState &mem, Address addr) {
+    return mem.use_page_table && mem.page_table[addr / KiB(4)] != mem.memory.get();
+}
+
+static void remove_guest_alias_mapping(MemState &mem, Address addr, uint32_t size) {
+    if (!mem.use_page_table) {
+#ifndef _WIN32
+        if (mem.memory_backing_fd >= 0)
+            mmap(mem.memory.get() + addr, size, PROT_READ | PROT_WRITE,
+                MAP_SHARED | MAP_FIXED, mem.memory_backing_fd, addr);
+#endif
+        return;
+    }
+    for (uint32_t offset = 0; offset < size; offset += KiB(4))
+        mem.page_table[(addr + offset) / KiB(4)] = mem.memory.get();
+}
